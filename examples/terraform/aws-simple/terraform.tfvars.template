//name = ""

// CIDRs allowed to reach the cluster from outside it (SSH, WinRM over HTTPS,
// MKE/MSR and the Kubernetes API).
//
// Defaults to ["0.0.0.0/0"] -- open to the whole internet. That is a real
// risk, and it is the exposure this example has always had; it is left as the
// default so an existing tfvars keeps working and a first run needs no extra
// arguments. Narrow it whenever you can: list the machine running launchpad
// and the operators who need the MKE UI. Uncomment and edit:
//
// admin_cidrs = ["198.51.100.17/32", "203.0.113.0/24"]

// CIDRs allowed to reach the Kubernetes NodePort range (32768-35535, the
// range this example installs MKE with).
//
// Unset means "the same as admin_cidrs", so with both left alone the
// NodePort range is reachable from the whole internet -- the same real risk
// as above, and the exposure this example had before its ingress rules were
// scoped. Set this when the people who reach your applications are not the
// people who administer the cluster: widening admin_cidrs to admit
// application clients would also hand them SSH and the MKE and Kubernetes
// APIs. Uncomment and edit:
//
// nodeport_cidrs = ["203.0.113.0/24"]

aws = {
  region = "us-east-2"
}

// Credentials: both the MKE admin password below and windows_password at the
// bottom of this file are ordinary terraform variables, and setting them here
// is all that is needed.
//
// If you would rather not keep a password in this file, terraform reads any
// input variable from TF_VAR_<name> in the environment instead:
//
//   export TF_VAR_launchpad='{"drain":false,"mcr_channel":"stable-25.0.14","mke_version":"3.8.8","msr_version":"2.9.28","mke_connect":{"username":"admin","password":"...","insecure":true},"skip_create":false,"skip_destroy":true}'
//   export TF_VAR_windows_password='...'
//
// The MKE password is nested inside the launchpad object, so TF_VAR_launchpad
// carries that whole object as JSON. Omit the launchpad block below if you
// use it. Either route works; the environment is optional.

launchpad = {
  drain = false

  mcr_channel = "stable-25.0.14"
  mke_version = "3.8.8"
  msr_version = "2.9.28"

  mke_connect = {
    username = "admin"
    password = "" // an MKE password must be provided
    insecure = true
  }

  skip_create  = false
  skip_destroy = true // don't bother running launchpad reset
}

// configure the network stack
network = {
  "cidr": "172.31.0.0/16",
}

// configure the subnets in the vpc
subnets = {
  "main" = {
    "cidr" = "172.31.0.0/17",
    "private" = false,
    "nodegroups" = ["MngrA",  "Wrkubuntu", "Wrkrhel", "Wrksles"]
  }
}

// one definition for each group of machines to include in the stack
nodegroups = {
  "MngrA" = {
    "platform" = "ubuntu_22.04",
    "count" = 1,
    "type" = "m6a.2xlarge",
    "volume_size" = "100",
    "role" = "manager",
    "user_data" = "sudo ufw allow 2377,7946,10250/tcp; sudo ufw allow 7946,4789/udp"
  },
  "Wrkrhel" = {
    "platform" = "rhel_9",
    "count" = 1,
    "type" = "c6a.xlarge",
    "volume_size" = "100",
    "role" = "worker",
    "user_data" = "sudo firewall-cmd --permanent --add-port=2377/tcp --add-port=7946/tcp --add-port=7946/udp --add-port=4789/udp --add-port=10250/tcp; sudo firewall-cmd --reload"
  },
  "Wrkubuntu" = {
    "platform" = "ubuntu_22.04",
    "count" = 1,
    "type" = "c6a.xlarge",
    "volume_size" = "100",
    "role" = "worker",
    "user_data" = "sudo ufw allow 2377,7946,10250/tcp; sudo ufw allow 7946,4789/udp"
  },
  "Wrksles" = {
    "platform" = "sles_15",
    "count" = 1,
    "type" = "c6a.xlarge",
    "volume_size" = "100",
    "role" = "worker",
    "user_data" = "sudo firewall-cmd --permanent --add-port=2377/tcp --add-port=7946/tcp --add-port=7946/udp --add-port=4789/udp --add-port=10250/tcp; sudo firewall-cmd --reload"
  },
}

// set a windows password, if you have windows nodes
// windows passwords must match a pattern, or connections will fail.
// use something like: `testp@ss!`
// Required only when a nodegroup uses a windows_ platform; may also be
// supplied as TF_VAR_windows_password instead of being written here.
// windows_password = ""
